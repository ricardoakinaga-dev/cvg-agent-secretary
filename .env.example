NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# PostgreSQL
POSTGRES_DB=cvg_agent
POSTGRES_ADMIN_USER=cvg_migrator
POSTGRES_ADMIN_PASSWORD=replace-with-admin-secret
POSTGRES_APP_USER=cvg_agent
POSTGRES_APP_PASSWORD=replace-with-app-secret
DATABASE_URL=postgresql://cvg_agent:replace-with-app-secret@localhost:5432/cvg_agent
DB_MAX_CONNECTIONS=10
ALLOW_INSECURE_PRIVATE_STORES=false

# Redis
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=cvg-agent
REDIS_PASSWORD=replace-with-redis-secret

# AI provider
AI_PROVIDER=auto
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4.1
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Optional fallback provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Chatwoot
CHATWOOT_API_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=replace-me
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_IDS=1
CHATWOOT_WEBHOOK_SECRET=replace-me

# Operational API auth
API_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-base64-key\n-----END PUBLIC KEY-----
API_JWT_ISSUER=https://identity.example.com
API_JWT_AUDIENCE=cvg-agent-secretary
ALLOW_LEGACY_API_TOKEN=false
# Optional local-development fallback; requires ALLOW_LEGACY_API_TOKEN=true.
API_ADMIN_TOKEN=

# Privacy operations remain disabled until policy, recovery checkpoints and
# store attestations are formally approved and versioned.
PRIVACY_ENABLED=false
PRIVACY_RETENTION_POLICIES_JSON=[]
PRIVACY_RECOVERY_CHECKPOINTS_JSON=[]
PRIVACY_QDRANT_ATTESTATION_ID=
PRIVACY_LOGS_ATTESTATION_ID=

# Required in production. Values are supplied by the secret manager; each key
# must decode to exactly 32 bytes. Keep previous encryption keys during rotation.
PII_ENCRYPTION_REQUIRED=false
PII_ACTIVE_KEY_ID=
PII_ENCRYPTION_KEYS_JSON={}
PII_LOOKUP_KEY=

# Optional Qdrant vector store. The default Compose runtime uses the shared
# institutional collection. To run the bundled local Qdrant instead, start
# Compose with --profile standalone-qdrant and set QDRANT_URL=http://qdrant:6333.
KNOWLEDGE_VECTOR_STORE=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=cvg_knowledge_chunks

# Optional direct EvolutionAPI provider. The main runtime replies via Chatwoot.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
WHATSAPP_INSTANCE=default
SEND_EVOLUTION_TEST_MESSAGE=false
TEST_WHATSAPP_NUMBER=
EVOLUTION_TEST_MESSAGE=Teste automatico EvolutionAPI -> WhatsApp.

# Staging smoke test. Use an existing Chatwoot conversation/contact in staging.
AGENT_BASE_URL=http://localhost:3000
SMOKE_CHATWOOT_CONVERSATION_ID=1
SMOKE_CHATWOOT_ACCOUNT_ID=1
SMOKE_CHATWOOT_INBOX_ID=1
SMOKE_CHATWOOT_CONTACT_ID=1
SMOKE_CHATWOOT_CONTACT_NAME=Smoke Test
SMOKE_MESSAGE_CONTENT=Teste automatico de readiness do agent-secretary.
SMOKE_STRICT_HEALTH=true
SMOKE_TIMEOUT_MS=10000
